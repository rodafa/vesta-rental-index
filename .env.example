# =============================================================================
# Vesta Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vesta_dashboard

# RentVine
RENTVINE_SUBDOMAIN=
RENTVINE_API_KEY=
RENTVINE_API_SECRET=

# RentEngine
RENTENGINE_BASE_URL=
RENTENGINE_API_TOKEN=
RENTENGINE_ACCOUNT_ID=
RENTENGINE_WEBHOOK_SECRET=

# BoomPay / BoomScreen
BOOMPAY_BASE_URL=
BOOMPAY_API_KEY=
BOOMPAY_API_SECRET=

# PropertyMeld
PROPERTY_MELD_CLIENT_ID=
PROPERTY_MELD_CLIENT_SECRET=
PROPERTY_MELD_MANAGEMENT_ID=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=
VESTA_FROM_EMAIL=

# Anthropic (draft generation)
ANTHROPIC_API_KEY=
